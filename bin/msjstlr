#!/usr/bin/env bash
# bin/msjstlr
# Mesgjs Transpile-Load-Run Cross-Engine Launcher
# Copyright 2026 by Kappa Computer Solutions, LLC and Brian Katzung
# Author: Brian Katzung <briank@kappacs.com>

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

DENO_FLAGS=()
MSJSTLR_ARGS=()
CLI_RUNTIME=""
CLI_CONFIG=""
in_deno=0

while [ $# -gt 0 ]; do
  arg="$1"
  shift

  if [ $in_deno -eq 1 ]; then
    if [ "$arg" = "--" ]; then
      in_deno=0
    else
      DENO_FLAGS+=("$arg")
    fi
    continue
  fi

  case "$arg" in
    -d|--deno)
      in_deno=1
      ;;
    -c|--config)
      if [ $# -gt 0 ]; then
        CLI_CONFIG="$1"
        shift
      else
        echo "Error: $arg requires an argument" >&2
        exit 1
      fi
      ;;
    -c=*)
      CLI_CONFIG="${arg#-c=}"
      ;;
    --config=*)
      CLI_CONFIG="${arg#--config=}"
      ;;
    -r|--runtime)
      if [ $# -gt 0 ]; then
        CLI_RUNTIME="$1"
        shift
      else
        echo "Error: $arg requires an argument" >&2
        exit 1
      fi
      ;;
    -r=*)
      CLI_RUNTIME="${arg#-r=}"
      ;;
    --runtime=*)
      CLI_RUNTIME="${arg#--runtime=}"
      ;;
    --)
      MSJSTLR_ARGS+=("--" "$@")
      break
      ;;
    *)
      MSJSTLR_ARGS+=("$arg")
      ;;
  esac
done

if [ -n "$CLI_RUNTIME" ]; then
  RUNTIME_DIR="$CLI_RUNTIME"
elif [ -n "$MESGJS_RUNTIME" ]; then
  RUNTIME_DIR="$MESGJS_RUNTIME"
else
  RUNTIME_DIR="$( cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"
fi

RUNTIME_DIR="$( cd -P "$RUNTIME_DIR" >/dev/null 2>&1 && pwd || echo "$RUNTIME_DIR" )"
RUNTIME_DIR="${RUNTIME_DIR%/}"

if [ -n "$CLI_CONFIG" ]; then
  CONFIG="$CLI_CONFIG"
else
  CONFIG="$RUNTIME_DIR/webload.json"
fi

CLI_TARGET="$RUNTIME_DIR/cli/msjstlr-startup.esm.js"

# Deno permission defaults calculation
ALLOW_READ='--allow-read'
ALLOW_ENV='--allow-env'

for flag in "${DENO_FLAGS[@]}"; do
  case "$flag" in
    -A|--allow-all)
      ALLOW_READ=''
      ALLOW_ENV=''
      ;;
    --allow-read|--allow-read=*)
      ALLOW_READ=''
      ;;
    --allow-env|--allow-env=*)
      ALLOW_ENV=''
      ;;
  esac
done

# 1. Explicit Engine Override
case "$MESGJS_ENGINE" in
  "") ;;
  deno)
    exec deno run --config "$CONFIG" $ALLOW_READ $ALLOW_ENV "${DENO_FLAGS[@]}" "$CLI_TARGET" "${MSJSTLR_ARGS[@]}"
    ;;
  bun)
    exec wicbun --config "$CONFIG" "$CLI_TARGET" "${MSJSTLR_ARGS[@]}"
    ;;
  node)
    exec wicnode --config "$CONFIG" "$CLI_TARGET" "${MSJSTLR_ARGS[@]}"
    ;;
  *)
    echo "Error: Unknown MESGJS_ENGINE '$MESGJS_ENGINE'. Expected 'deno', 'bun', or 'node'." >&2
    exit 1
    ;;
esac

# 2. Automated Probe Ladder (Deno -> Bun/wicbun -> Node/wicnode)
if command -v deno >/dev/null 2>&1; then
  exec deno run --config "$CONFIG" $ALLOW_READ $ALLOW_ENV "${DENO_FLAGS[@]}" "$CLI_TARGET" "${MSJSTLR_ARGS[@]}"
elif command -v wicbun >/dev/null 2>&1 && command -v bun >/dev/null 2>&1; then
  exec wicbun --config "$CONFIG" "$CLI_TARGET" "${MSJSTLR_ARGS[@]}"
elif command -v wicnode >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
  exec wicnode --config "$CONFIG" "$CLI_TARGET" "${MSJSTLR_ARGS[@]}"
else
  echo "Error: msjstlr requires Deno, wicbun (from @bkatzung/webload) and bun, or wicnode (from @bkatzung/webload) and node." >&2
  echo "Install Deno (https://deno.land) or install WebLoad (npm i -g @bkatzung/webload) with node and/or bun." >&2
  exit 1
fi
